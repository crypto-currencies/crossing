generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Role hierarchy ───────────────────────────────────────────────────────────
// USER      — every new account
// MODERATOR — can review submissions/reports; cannot modify users
// ADMIN     — full moderation access; cannot modify OWNER accounts
// OWNER     — platform owner(s); unrestricted
enum UserRole {
  USER
  MODERATOR
  ADMIN
  OWNER
}

model User {
  id       String   @id @default(cuid())
  name     String?
  email    String?  @unique
  image    String?
  role     UserRole @default(USER)
  verified Boolean  @default(false)

  onboardingCompleted Boolean   @default(false)
  passwordHash        String?
  passwordChangedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts       Account[]
  sessions       Session[]
  securityEvents SecurityEvent[]
  notifications  Notification[]

  // Suspend state — set by admin actions
  suspendedAt     DateTime?
  suspendedReason String?
  // Role tracking — who last changed this user's role and when
  roleChangedAt   DateTime?
  roleGrantedById String? // adminId who made the last role change
  // Email verification — set when the user clicks the verification link.
  // Null for accounts created before this feature or via OAuth (already verified by provider).
  emailVerifiedAt DateTime?

  preferences UserPreferences?

  submissions         Submission[] @relation("SubmittedBy")
  reviewedSubmissions Submission[] @relation("ReviewedBy")
  submittedListings   Listing[]    @relation("ListingSubmittedBy")
  approvedListings    Listing[]    @relation("ListingApprovedBy")
  saves               Save[]
  votes               Vote[]

  // ── Product domain (docs/backend-product-plan.md) ──
  // Business capability is membership-based: a user is never a "business user",
  // they simply hold BusinessMembership rows alongside their consumer data.
  businessMemberships    BusinessMembership[]
  createdBusinesses      Business[]               @relation("BusinessCreatedBy")
  sentInvitations        BusinessInvitation[]     @relation("InvitationInvitedBy")
  requestedClaims        ListingClaim[]           @relation("ClaimRequestedBy")
  reviewedClaims         ListingClaim[]           @relation("ClaimReviewedBy")
  savedItems             SavedItem[]
  collections            Collection[]
  contributions          Contribution[]           @relation("ContributionSubmittedBy")
  assignedContributions  Contribution[]           @relation("ContributionAssignedTo")
  reviewedContributions  Contribution[]           @relation("ContributionReviewedBy")
  searchEvents           SearchEvent[]
  recommendationFeedback RecommendationFeedback[]
  journalPosts           JournalPost[]            @relation("JournalAuthor")
  approvedLegalDocuments LegalDocument[]          @relation("LegalApprovedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  // Device metadata (captured at session creation)
  userAgent    String?
  ipHash       String? // SHA-256 of client IP — never returned to client
  maskedIp     String? // Display-safe partial IP (e.g. "104.28.xx.xx")
  deviceHint   String? // "Chrome on macOS", "Safari on iOS", etc.
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Notification ─────────────────────────────────────────────────────────────
// System-generated notifications (e.g. submission approved/rejected). No
// user-to-user "actor" concept — Crossing.dev has no social graph.

model Notification {
  id     String @id @default(cuid())
  userId String // recipient
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  String // NotificationType
  title String
  body  String
  href  String?
  read  Boolean @default(false)

  entityId   String?
  entityType String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt(sort: Desc)])
}

// ─── Admin Audit Log ─────────────────────────────────────────────────────────
// Records every destructive admin action for accountability and rollback.
// adminId / targetUserId are plain string FKs — no Prisma relation needed
// since we query by raw ID and don't need join-time type safety here.

model AdminAuditLog {
  id           String   @id @default(cuid())
  adminId      String
  action       String // "verify.grant" | "verify.revoke" | "suspend" | "unsuspend" | "role.grant" | "role.revoke"
  targetUserId String?
  metadata     Json? // snapshot of changed fields
  createdAt    DateTime @default(now())

  @@index([adminId])
  @@index([targetUserId])
  @@index([createdAt(sort: Desc)])
}

// ─── Security Events ──────────────────────────────────────────────────────────
// Append-only log of security-relevant actions on a user account.
// Shown in Settings → Security → Security log.

model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String
  type      String // "login" | "login_failed" | "password_set" | "password_changed" | ...
  metadata  Json? // optional context (masked IP string, device hint, etc.)
  ipHash    String? // SHA-256 of client IP (not reversible; used for display bucketing only)
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
}

// ─── User Preferences ────────────────────────────────────────────────────────
// Per-user notification preferences. One row per user, created on first PATCH.

model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailNotifications Boolean @default(true)
  pushEnabled        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─── Password Reset Tokens ────────────────────────────────────────────────────
// Single-use tokens for the forgot-password flow.
// The token is stored as a SHA-256 hex hash — never in plain text.
// Tokens expire after 1 hour and are consumed (usedAt set) on use.

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String // the address the reset was requested for
  tokenHash String    @unique // SHA-256 of the plain-text URL token
  expiresAt DateTime
  usedAt    DateTime? // null = unused
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// Discovery domain — categories, listings, submissions, saves, votes
// ═══════════════════════════════════════════════════════════════════════════
//
// Flow: a user creates a Submission (an untrusted, user-authored proposal).
// A moderator/admin approves or rejects it. Approving CREATES a new Listing
// — the Submission row is never mutated into a Listing in place — so the
// originally-submitted content stays intact as a permanent audit trail even
// if the published Listing is later edited directly by an admin. Rejecting
// just marks the Submission REJECTED and no Listing is ever created for it,
// which is what keeps rejected content out of every public query for free:
// public reads only ever select from Listing, never from Submission.

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

// Listings have no PENDING/REJECTED state of their own — unapproved content
// never becomes a Listing at all (see flow note above). ARCHIVED is the only
// post-publish moderation action: pulling a previously-published listing
// from public view without deleting its history.
enum ListingStatus {
  PUBLISHED
  ARCHIVED
}

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  icon        String? // lucide-react icon name, resolved client-side
  position    Int     @default(0) // manual display order, lowest first
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings    Listing[]
  submissions Submission[]

  @@index([isActive, position])
}

model Listing {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  tagline       String
  description   String
  websiteUrl    String // display URL, as submitted
  websiteUrlKey String        @unique // normalized form — enforces one listing per site
  logoUrl       String?
  coverImageUrl String?
  status        ListingStatus @default(PUBLISHED)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Nullable + SetNull: published content must survive its submitter's or
  // approver's account being deleted — it isn't their personal data anymore.
  submittedById String?
  submittedBy   User?     @relation("ListingSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  approvedById  String?
  approvedBy    User?     @relation("ListingApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt    DateTime?
  publishedAt   DateTime  @default(now())

  // Cached ranking signals — denormalized counters kept in sync by the
  // save/vote data-access functions (features/saves, features/votes), not
  // derived ad hoc per query. rankingScore is recomputed periodically by
  // features/listings/ranking.ts, not on every mutation. See docs/ranking-v0.md.
  saveCount      Int   @default(0)
  voteCount      Int   @default(0)
  viewCount      Int   @default(0)
  rankingScore   Float @default(0)
  // Manual editorial nudge, strictly capped — see docs/ranking-v0.md.
  editorialBoost Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submission Submission?
  saves      Save[]
  votes      Vote[]
  /// Optional bridge to the canonical recommendation entity (never auto-merged).
  entity     Entity?

  @@index([status, categoryId])
  @@index([status, rankingScore(sort: Desc)])
  @@index([status, publishedAt(sort: Desc)])
}

// A user-authored proposal for a new listing. Preserved permanently as
// originally submitted, independent of moderation outcome — see flow note above.
model Submission {
  id            String           @id @default(cuid())
  name          String
  websiteUrl    String
  websiteUrlKey String // normalized form — checked (not uniquely constrained) for duplicate warnings
  tagline       String
  description   String
  status        SubmissionStatus @default(PENDING)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  submittedById String
  submittedBy   User   @relation("SubmittedBy", fields: [submittedById], references: [id], onDelete: Cascade)

  moderatorNote String?
  reviewedById  String?
  reviewedBy    User?     @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?

  // Set only once APPROVED — the Listing this submission produced.
  listingId String?  @unique
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([submittedById])
  @@index([status, createdAt(sort: Desc)])
  @@index([websiteUrlKey])
}

// A private bookmark — no public or ranking signal. One save per user per listing.
model Save {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([listingId])
}

// A lightweight positive signal ("recommend this"). Feeds ranking. One vote per user per listing.
model Vote {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([listingId])
}

// ─── Evidence Snapshots ────────────────────────────────────────────────────────
// Append-only, versioned evidence from source adapters (official-site first).
// A refresh writes a NEW row; history is never overwritten. We store hashes +
// constrained excerpts (in `provenance`/`pages`) — NEVER full raw HTML.
// See features/ingestion/ and docs/ingestion.md.

model EvidenceSnapshot {
  id                 String   @id @default(cuid())
  entityId           String
  adapterId          String
  primarySourceUrl   String
  retrievedAt        DateTime
  ok                 Boolean
  httpStatus         Int? // representative page status (null when no page fetched)
  httpMeta           Json // { pagesFetched, pagesFailed, totalBytes, totalDurationMs }
  contentFingerprint String
  extractionVersion  String
  attributes         Json // normalized engine attributes
  pricing            Json // normalized pricing model
  provenance         Json // per-attribute provenance (constrained excerpts only)
  pages              Json // per-page results (url, status, bytes, fingerprint, error) — no HTML
  confidence         Float
  freshnessStatus    String
  warnings           Json
  errorKind          String? // classification when the run failed
  errorMessage       String?
  createdAt          DateTime @default(now())

  // Dedup guard: an identical fingerprint for an entity is never stored twice.
  @@unique([entityId, contentFingerprint])
  @@index([entityId])
  @@index([adapterId])
  @@index([retrievedAt(sort: Desc)])
  @@index([contentFingerprint])
  // Latest-valid-snapshot lookup.
  @@index([entityId, ok, retrievedAt(sort: Desc)])
}

// ═══════════════════════════════════════════════════════════════════════════════
// PRODUCT DOMAIN — see docs/backend-product-plan.md
// Additive only: no model above is altered. Every surface is gated by a feature
// flag (lib/server/feature-flags.ts) so an un-enabled deploy is inert.
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Canonical recommendation entity ──────────────────────────────────────────
// The recommendation unit. Deliberately separate from Listing (community
// directory) — see plan section 2. `source` keeps fictional demo data out of
// production retrieval.

enum EntityStatus {
  DRAFT
  ACTIVE
  HIDDEN
  ARCHIVED
  CLOSED
}

enum EntitySource {
  CANONICAL
  DEMO
}

model Entity {
  id             String       @id @default(cuid())
  /// Stable public key, also the ingestion registry key (e.g. "matomo").
  key            String       @unique
  canonicalName  String
  /// Code-defined recommendation category id (e.g. "analytics-tools").
  categoryId     String
  officialDomain String
  /// Normalized comparison key — prevents accidental duplicate entities.
  domainKey      String       @unique
  description    String       @default("")
  /// Engine-usable facts; keys match category attribute keys.
  attributes     Json         @default("{}")
  status         EntityStatus @default(DRAFT)
  source         EntitySource @default(CANONICAL)

  /// Optional bridge to the legacy community directory. Never auto-merged.
  listingId String?  @unique
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  claimedByBusinessId String?
  claimedByBusiness   Business? @relation(fields: [claimedByBusinessId], references: [id], onDelete: SetNull)

  lastUpdatedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  aliases     EntityAlias[]
  externalIds EntityExternalId[]
  savedItems  SavedItem[]
  claims      ListingClaim[]
  feedback    RecommendationFeedback[]

  @@index([categoryId, status, source])
  @@index([status, lastUpdatedAt(sort: Desc)])
  @@index([claimedByBusinessId])
}

model EntityAlias {
  id       String @id @default(cuid())
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  alias    String

  @@unique([entityId, alias])
  @@index([alias])
}

model EntityExternalId {
  id         String @id @default(cuid())
  entityId   String
  entity     Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  sourceType String
  externalId String
  url        String

  @@unique([sourceType, externalId])
  @@index([entityId])
}

// ─── Business / organization ──────────────────────────────────────────────────
// A business is NOT a user type. Capability comes from BusinessMembership rows,
// so one person can be both a consumer and a business representative.

enum BusinessRole {
  OWNER
  ADMIN
  EDITOR
  ANALYST
  BILLING
}

enum BusinessStatus {
  PENDING_VERIFICATION
  VERIFIED
  SUSPENDED
}

model Business {
  id         String         @id @default(cuid())
  name       String
  slug       String         @unique
  /// Normalized primary domain — basis for domain-ownership verification.
  domainKey  String?        @unique
  websiteUrl String?
  status     BusinessStatus @default(PENDING_VERIFICATION)
  verifiedAt DateTime?

  createdById String?
  createdBy   User?   @relation("BusinessCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships BusinessMembership[]
  invitations BusinessInvitation[]
  claims      ListingClaim[]
  entities    Entity[]

  @@index([status])
}

model BusinessMembership {
  id         String       @id @default(cuid())
  businessId String
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       BusinessRole @default(EDITOR)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, userId])
  @@index([userId])
  @@index([businessId, role])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model BusinessInvitation {
  id               String           @id @default(cuid())
  businessId       String
  business         Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Always stored lowercase and trimmed.
  email            String
  role             BusinessRole     @default(EDITOR)
  /// SHA-256 of the emailed token — never the plaintext.
  tokenHash        String           @unique
  status           InvitationStatus @default(PENDING)
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?

  invitedById String?
  invitedBy   User?   @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([email])
  @@index([businessId, status])
  @@index([status, expiresAt])
}

// ─── Listing claim (ownership proof) ──────────────────────────────────────────

enum ClaimStatus {
  STARTED
  EMAIL_VERIFICATION_PENDING
  DOMAIN_VERIFICATION_PENDING
  DOCUMENT_REVIEW_PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum ClaimMethod {
  EMAIL_DOMAIN
  DNS_TXT
  FILE_TOKEN
  MANUAL_REVIEW
}

model ListingClaim {
  id         String      @id @default(cuid())
  entityId   String
  entity     Entity      @relation(fields: [entityId], references: [id], onDelete: Cascade)
  businessId String
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  status     ClaimStatus @default(STARTED)
  method     ClaimMethod

  /// SHA-256 of the verification token; single-use and expiring.
  tokenHash      String?   @unique
  expiresAt      DateTime?
  consumedAt     DateTime?
  /// Exact value the claimant must publish (DNS TXT value / file contents).
  challenge      String?
  verifiedAt     DateTime?
  rejectedReason String?

  requestedById String?
  requestedBy   User?   @relation("ClaimRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedById  String?
  reviewedBy    User?   @relation("ClaimReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events ClaimEvent[]

  @@index([entityId, status])
  @@index([businessId, status])
}

model ClaimEvent {
  id         String       @id @default(cuid())
  claimId    String
  claim      ListingClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  fromStatus ClaimStatus?
  toStatus   ClaimStatus
  note       String?
  actorId    String?
  createdAt  DateTime     @default(now())

  @@index([claimId, createdAt])
}

// ─── Saved items + collections ────────────────────────────────────────────────
// Distinct from the legacy `Save` model, which bookmarks a `Listing`. This saves
// a recommendation `Entity` — the thing search actually returns.

model SavedItem {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  note        String?
  tags        String[] @default([])
  /// Optional provenance: the search that produced this save.
  sourceQuery String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collectionItems CollectionItem[]

  @@unique([userId, entityId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([entityId])
}

model Collection {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  isDefault Boolean @default(false)
  position  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CollectionItem[]

  @@unique([userId, slug])
  @@index([userId, position])
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  savedItemId  String
  savedItem    SavedItem  @relation(fields: [savedItemId], references: [id], onDelete: Cascade)
  position     Int        @default(0)
  createdAt    DateTime   @default(now())

  @@unique([collectionId, savedItemId])
  @@index([collectionId, position])
}

// ─── Unified contribution pipeline ────────────────────────────────────────────

enum ContributionKind {
  SUGGEST_LISTING
  SUBMIT_LISTING
  CORRECT_INFORMATION
  REPORT_OUTDATED_EVIDENCE
  SUGGEST_CATEGORY
  REPORT_BROKEN_OR_CLOSED
  RECOMMENDATION_FEEDBACK
}

enum ContributionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_INFORMATION
  APPROVED
  REJECTED
  WITHDRAWN
}

model Contribution {
  id     String             @id @default(cuid())
  kind   ContributionKind
  status ContributionStatus @default(SUBMITTED)

  /// Target entity when correcting/reporting an existing option.
  entityId     String?
  /// Free-form target hint when no entity exists yet.
  targetName   String?
  targetUrl    String?
  targetUrlKey String?
  categoryId   String?

  /// Structured payload, validated per-kind by Zod before insert.
  payload   Json    @default("{}")
  /// Submitter-supplied provenance for the claim being made.
  sourceUrl String?
  comment   String?

  submittedById String?
  submittedBy   User?   @relation("ContributionSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  /// Hashed identifier for limited anonymous flows — never a raw IP.
  anonymousHash String?

  /// Business origin when a claimed business submits a correction.
  businessId String?

  moderatorNote    String?
  resolutionReason String?
  assignedToId     String?
  assignedTo       User?     @relation("ContributionAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  reviewedById     String?
  reviewedBy       User?     @relation("ContributionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?

  /// Set when duplicate detection matches an existing contribution.
  duplicateOfId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events ContributionEvent[]

  @@index([status, createdAt(sort: Desc)])
  @@index([kind, status])
  @@index([submittedById])
  @@index([entityId])
  @@index([targetUrlKey])
}

model ContributionEvent {
  id             String              @id @default(cuid())
  contributionId String
  contribution   Contribution        @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  fromStatus     ContributionStatus?
  toStatus       ContributionStatus
  note           String?
  actorId        String?
  createdAt      DateTime            @default(now())

  @@index([contributionId, createdAt])
}

// ─── Search + feedback events ─────────────────────────────────────────────────

model SearchEvent {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Nulled by the retention job after the configured window.
  rawQuery        String?
  categoryId      String?
  /// success | unsupported-category | needs-clarification | no-results | error
  responseStatus  String
  resultEntityIds String[] @default([])
  bestEntityId    String?
  timingMs        Int?
  /// Correlates feedback/click events without exposing identity.
  requestId       String?

  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([categoryId, createdAt(sort: Desc)])
  @@index([requestId])
}

enum FeedbackKind {
  HELPFUL
  NOT_HELPFUL
  WRONG_CATEGORY
  MISSED_OPTION
  INCORRECT_FACT
  OUTDATED_INFORMATION
}

model RecommendationFeedback {
  id        String       @id @default(cuid())
  kind      FeedbackKind
  requestId String?
  entityId  String?
  entity    Entity?      @relation(fields: [entityId], references: [id], onDelete: SetNull)

  userId        String?
  user          User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Hashed anonymous session token — never a raw IP or cookie value.
  anonymousHash String?

  comment     String?
  needsReview Boolean   @default(false)
  reviewedAt  DateTime?

  createdAt DateTime @default(now())

  @@unique([requestId, kind, userId])
  @@index([entityId, kind])
  @@index([createdAt(sort: Desc)])
}

// ─── Editorial journal ────────────────────────────────────────────────────────

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model JournalPost {
  id      String     @id @default(cuid())
  slug    String     @unique
  title   String
  summary String     @default("")
  /// Sanitized at render time; see the contract in features/journal.
  body    String     @default("")
  status  PostStatus @default(DRAFT)

  authorId String?
  author   User?   @relation("JournalAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  heroImageUrl   String?
  tags           String[] @default([])
  categoryId     String?
  readMinutes    Int      @default(0)
  seoTitle       String?
  seoDescription String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId])
}

// ─── Versioned legal documents ────────────────────────────────────────────────
// Content is authored/approved by the product owner — never generated.

enum LegalDocumentType {
  TERMS
  PRIVACY
  COOKIES
  DMCA
  PROMOTION_DISCLOSURE
  PLATFORM_POLICIES
}

model LegalDocument {
  id            String            @id @default(cuid())
  type          LegalDocumentType
  version       Int
  title         String
  body          String
  /// Published documents are immutable; a change means a new version row.
  isPublished   Boolean           @default(false)
  effectiveDate DateTime?
  publishedAt   DateTime?

  approvedById String?
  approvedBy   User?   @relation("LegalApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, version])
  @@index([type, isPublished, effectiveDate(sort: Desc)])
}
